# =====================================================================
#  ELearningPlatform - ornek ayar dosyasi
#  Bu dosyayi ".env" adiyla kopyala ve degerleri doldur.
#  .env git'e gonderilmez; bu ornek dosya ise repoda kalir.
# =====================================================================

# --- Docker (docker-compose.yml bu degeri okur) ---
# En az 8 karakter; buyuk/kucuk harf, rakam ve sembol icermeli.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# --- Veritabani baglantilari (API okur) ---
# SqlCon icindeki Password, yukaridaki MSSQL_SA_PASSWORD ile ayni olmali.
ConnectionStrings__SqlCon=Server=localhost,1433;Database=ELearnPlatformDb;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;
ConnectionStrings__Redis=localhost:6378
ConnectionStrings__MongoDb=mongodb+srv://<kullanici>:<sifre>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# --- JWT ---
# En az 64 karakterlik rastgele bir metin.
TokenOption__SecurityKey=buraya-en-az-64-karakterlik-rastgele-bir-anahtar-yaz

# --- Cloudinary ---
CloudinarySettings__CloudName=
CloudinarySettings__ApiKey=
CloudinarySettings__ApiSecret=

# --- Ilk Admin kullanicisi (istege bagli) ---
# Doldurursan API ilk acilista bu bilgilerle bir Admin kullanicisi olusturur.
# Sifre en az 6 karakter, buyuk/kucuk harf ve rakam icermeli.
SeedAdmin__Email=
SeedAdmin__Password=
SeedAdmin__UserName=admin
